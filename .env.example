# Copy to .env and fill in. .env is ignored by Git and by Docker builds.
# Example values only: never put a real password or key in this file.
NODE_ENV=production
PORT=3000
DB_HOST=db
DB_PORT=5432
DB_USER=stockdesk
DB_PASSWORD=change-me-example-only
API_KEY=change-me-example-only
